---
import {
  ArrowLeftRight,
  Clipboard,
  Download,
  Play,
  Trash2,
  Upload,
} from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="标记语言转换"
  description="在 Markdown、HTML、Typst 与 LaTeX 之间进行本地转换。"
  wide
>
  <header class="tool-header">
    <p class="eyebrow">Tools / Convert</p>
    <h1>标记语言转换</h1>
    <p class="lede">Markdown、HTML、Typst 与 LaTeX。</p>
  </header>

  <div class="format-toolbar">
    <label class="field-label">
      输入格式
      <select class="select" id="source-format">
        <option value="auto">自动识别</option>
        <option value="markdown">Markdown</option>
        <option value="html">HTML</option>
        <option value="typst">Typst</option>
        <option value="latex">LaTeX</option>
      </select>
    </label>
    <button class="tool-button swap-button" id="swap-formats" type="button" title="交换格式" aria-label="交换输入与输出格式">
      <ArrowLeftRight size={18} aria-hidden="true" />
    </button>
    <label class="field-label">
      输出格式
      <select class="select" id="target-format">
        <option value="html">HTML</option>
        <option value="markdown">Markdown</option>
        <option value="typst">Typst</option>
        <option value="latex">LaTeX</option>
      </select>
    </label>
    <button class="tool-button primary convert-button" id="convert-document" type="button" disabled>
      <Play size={17} aria-hidden="true" /> 转换
    </button>
  </div>

  <div class="converter-status">
    <p id="convert-status" class="status-line" aria-live="polite">正在载入转换器…</p>
    <span>markweft-rs / WebAssembly</span>
  </div>

  <div class="editor-grid">
    <section class="editor-panel">
      <div class="panel-header">
        <label for="document-input">输入</label>
        <label class="panel-action" for="document-file">
          <Upload size={15} aria-hidden="true" /> 导入
          <input
            id="document-file"
            type="file"
            accept=".md,.markdown,.html,.htm,.typ,.typst,.tex,.latex,text/*"
          />
        </label>
      </div>
      <textarea
        class="textarea document-editor"
        id="document-input"
        spellcheck="false"
        placeholder="# Hello&#10;&#10;Start writing here…"></textarea>
      <div class="editor-footer">
        <span id="input-characters">0 字符</span>
        <button id="clear-document" type="button">
          <Trash2 size={14} aria-hidden="true" /> 清空
        </button>
      </div>
    </section>

    <section class="editor-panel">
      <div class="panel-header">
        <div class="view-tabs" role="tablist" aria-label="输出视图">
          <button
            class="view-tab active"
            id="source-view-tab"
            type="button"
            role="tab"
            aria-controls="document-output"
            aria-selected="true"
            tabindex="0"
          >源码</button>
          <button
            class="view-tab"
            id="preview-view-tab"
            type="button"
            role="tab"
            aria-controls="document-preview"
            aria-selected="false"
            tabindex="-1"
            disabled
          >预览</button>
        </div>
        <div class="panel-actions">
          <button id="copy-document" type="button" disabled>
            <Clipboard size={15} aria-hidden="true" /> 复制
          </button>
          <button id="download-document" type="button" disabled>
            <Download size={15} aria-hidden="true" /> 下载
          </button>
        </div>
      </div>
      <textarea
        class="textarea document-editor"
        id="document-output"
        role="tabpanel"
        aria-labelledby="source-view-tab"
        spellcheck="false"
        readonly
        placeholder="转换结果"></textarea>
      <iframe
        class="document-preview"
        id="document-preview"
        role="tabpanel"
        aria-labelledby="preview-view-tab"
        title="转换结果预览"
        sandbox=""
        hidden></iframe>
      <div class="editor-footer">
        <span id="output-characters">0 字符</span>
        <span id="detected-format"></span>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  type FormatName = "markdown" | "html" | "typst" | "latex";
  type WorkerResponse =
    | { type: "ready" }
    | {
        type: "result";
        id: number;
        output: string;
        previewHtml: string;
        detectedFormat: FormatName;
      }
    | { type: "error"; id?: number; message: string };

  const formatLabels: Record<FormatName, string> = {
    markdown: "Markdown",
    html: "HTML",
    typst: "Typst",
    latex: "LaTeX",
  };
  const extensions: Record<FormatName, string> = {
    markdown: "md",
    html: "html",
    typst: "typ",
    latex: "tex",
  };
  const mimeTypes: Record<FormatName, string> = {
    markdown: "text/markdown;charset=utf-8",
    html: "text/html;charset=utf-8",
    typst: "text/plain;charset=utf-8",
    latex: "application/x-tex;charset=utf-8",
  };
  const extensionFormats: Record<string, FormatName> = {
    md: "markdown",
    markdown: "markdown",
    html: "html",
    htm: "html",
    typ: "typst",
    typst: "typst",
    tex: "latex",
    latex: "latex",
  };

  const sourceFormat = document.querySelector<HTMLSelectElement>("#source-format");
  const targetFormat = document.querySelector<HTMLSelectElement>("#target-format");
  const input = document.querySelector<HTMLTextAreaElement>("#document-input");
  const output = document.querySelector<HTMLTextAreaElement>("#document-output");
  const preview = document.querySelector<HTMLIFrameElement>("#document-preview");
  const sourceViewTab = document.querySelector<HTMLButtonElement>("#source-view-tab");
  const previewViewTab = document.querySelector<HTMLButtonElement>("#preview-view-tab");
  const status = document.querySelector<HTMLElement>("#convert-status");
  const detected = document.querySelector<HTMLElement>("#detected-format");
  const inputCharacters = document.querySelector<HTMLElement>("#input-characters");
  const outputCharacters = document.querySelector<HTMLElement>("#output-characters");
  const convertButton = document.querySelector<HTMLButtonElement>("#convert-document");
  const copyButton = document.querySelector<HTMLButtonElement>("#copy-document");
  const downloadButton = document.querySelector<HTMLButtonElement>("#download-document");
  const fileInput = document.querySelector<HTMLInputElement>("#document-file");

  const worker = new Worker(new URL("../../workers/markweft.worker.ts", import.meta.url), {
    type: "module",
  });
  let ready = false;
  let requestId = 0;
  let lastDetected: FormatName | undefined;

  function previewDocument(content: string) {
    return `<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data: blob:; font-src data:; style-src 'unsafe-inline'">
  <style>
    :root { color-scheme: dark; }
    body { margin: 0; padding: 24px; color: #d8dcd9; background: #0e110f; font: 15px/1.75 system-ui, sans-serif; }
    h1, h2, h3, h4, h5, h6 { margin: 1.4em 0 .6em; color: #edf0ee; line-height: 1.3; }
    h1:first-child, h2:first-child, h3:first-child { margin-top: 0; }
    h1 { font-size: 1.65rem; } h2 { font-size: 1.35rem; } h3 { font-size: 1.15rem; }
    p, ul, ol, blockquote, pre, table { margin: 0 0 1em; }
    a { color: #8fd3a9; pointer-events: none; } img { max-width: 100%; height: auto; }
    blockquote { margin-left: 0; padding-left: 1em; border-left: 2px solid #405047; color: #a7afa9; }
    code, pre { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
    code { color: #d7e9dc; } pre { overflow: auto; padding: 12px; background: #151a17; }
    table { width: 100%; border-collapse: collapse; } th, td { padding: 7px 9px; border: 1px solid #303a34; text-align: left; }
  </style>
</head>
<body>${content}</body>
</html>`;
  }

  function setOutputView(view: "source" | "preview") {
    const showPreview = view === "preview" && !previewViewTab?.disabled;
    if (output) output.hidden = showPreview;
    if (preview) preview.hidden = !showPreview;
    sourceViewTab?.classList.toggle("active", !showPreview);
    previewViewTab?.classList.toggle("active", showPreview);
    sourceViewTab?.setAttribute("aria-selected", String(!showPreview));
    previewViewTab?.setAttribute("aria-selected", String(showPreview));
    if (sourceViewTab) sourceViewTab.tabIndex = showPreview ? -1 : 0;
    if (previewViewTab) previewViewTab.tabIndex = showPreview ? 0 : -1;
  }

  function setStatus(message: string, state = "") {
    if (!status) return;
    status.textContent = message;
    status.dataset.state = state;
  }

  function setOutput(value: string, previewHtml = "", detectedFormat?: FormatName) {
    if (output) output.value = value;
    if (preview) preview.srcdoc = previewHtml ? previewDocument(previewHtml) : "";
    if (previewViewTab) previewViewTab.disabled = !previewHtml;
    if (outputCharacters) outputCharacters.textContent = `${value.length.toLocaleString()} 字符`;
    if (copyButton) copyButton.disabled = !value;
    if (downloadButton) downloadButton.disabled = !value;
    if (detected) {
      detected.textContent = detectedFormat ? `识别为 ${formatLabels[detectedFormat]}` : "";
    }
    if (!value) setOutputView("source");
  }

  function updateInputStats() {
    const length = input?.value.length ?? 0;
    if (inputCharacters) inputCharacters.textContent = `${length.toLocaleString()} 字符`;
  }

  function invalidateOutput() {
    requestId += 1;
    lastDetected = undefined;
    setOutput("");
    if (convertButton) convertButton.disabled = !ready;
    setStatus(ready ? "内容已修改，请重新转换" : "正在载入转换器…");
  }

  function requestConversion() {
    const source = input?.value ?? "";
    if (!source.trim()) return setStatus("请输入需要转换的内容", "error");
    if (!ready || !sourceFormat || !targetFormat || !convertButton) return;

    requestId += 1;
    convertButton.disabled = true;
    setStatus("正在转换…");
    worker.postMessage({
      type: "convert",
      id: requestId,
      source,
      from: sourceFormat.value,
      to: targetFormat.value,
    });
  }

  worker.addEventListener("message", ({ data }: MessageEvent<WorkerResponse>) => {
    if (data.type === "ready") {
      ready = true;
      if (convertButton) convertButton.disabled = false;
      setStatus("转换器已就绪", "success");
      return;
    }
    if (data.type === "result" && data.id === requestId) {
      lastDetected = data.detectedFormat;
      setOutput(data.output, data.previewHtml, data.detectedFormat);
      if (convertButton) convertButton.disabled = false;
      setStatus("转换完成", "success");
      return;
    }
    if (data.type === "error" && (data.id === undefined || data.id === requestId)) {
      if (convertButton) convertButton.disabled = !ready;
      setStatus(data.message || "转换失败", "error");
    }
  });

  worker.addEventListener("error", () => {
    if (convertButton) convertButton.disabled = true;
    setStatus("无法载入转换器", "error");
  });
  worker.postMessage({ type: "init" });

  document.querySelector("#convert-document")?.addEventListener("click", requestConversion);
  sourceViewTab?.addEventListener("click", () => setOutputView("source"));
  previewViewTab?.addEventListener("click", () => setOutputView("preview"));
  document.querySelector(".view-tabs")?.addEventListener("keydown", (event) => {
    if (!(event instanceof KeyboardEvent) || !["ArrowLeft", "ArrowRight"].includes(event.key)) return;
    event.preventDefault();
    const view = event.key === "ArrowRight" && !previewViewTab?.disabled
      ? "preview"
      : "source";
    setOutputView(view);
    (view === "preview" ? previewViewTab : sourceViewTab)?.focus();
  });
  input?.addEventListener("input", () => {
    updateInputStats();
    invalidateOutput();
  });
  sourceFormat?.addEventListener("change", invalidateOutput);
  targetFormat?.addEventListener("change", invalidateOutput);
  input?.addEventListener("keydown", (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key === "Enter") requestConversion();
  });

  document.querySelector("#swap-formats")?.addEventListener("click", () => {
    if (!sourceFormat || !targetFormat) return;
    const previousSource = sourceFormat.value === "auto"
      ? (lastDetected ?? "markdown")
      : sourceFormat.value;
    sourceFormat.value = targetFormat.value;
    targetFormat.value = previousSource;
    if (output?.value && input) {
      input.value = output.value;
      updateInputStats();
      setOutput("");
    }
    setStatus("格式已交换");
  });

  document.querySelector("#clear-document")?.addEventListener("click", () => {
    if (input) input.value = "";
    lastDetected = undefined;
    updateInputStats();
    setOutput("");
    setStatus(ready ? "转换器已就绪" : "正在载入转换器…", ready ? "success" : "");
    input?.focus();
  });

  fileInput?.addEventListener("change", async () => {
    const file = fileInput.files?.[0];
    if (!file || !input) return;
    try {
      input.value = await file.text();
      const extension = file.name.split(".").pop()?.toLowerCase() ?? "";
      const format = extensionFormats[extension];
      if (format && sourceFormat) sourceFormat.value = format;
      updateInputStats();
      invalidateOutput();
      setStatus(`${file.name} 已导入`, "success");
    } catch {
      setStatus("无法读取这个文件", "error");
    } finally {
      fileInput.value = "";
    }
  });

  copyButton?.addEventListener("click", async () => {
    if (!output?.value) return;
    try {
      await navigator.clipboard.writeText(output.value);
      setStatus("输出已复制", "success");
    } catch {
      setStatus("浏览器拒绝了剪贴板访问", "error");
    }
  });

  downloadButton?.addEventListener("click", () => {
    if (!output?.value || !targetFormat) return;
    const format = targetFormat.value as FormatName;
    const url = URL.createObjectURL(new Blob([output.value], { type: mimeTypes[format] }));
    const link = document.createElement("a");
    link.href = url;
    link.download = `converted.${extensions[format]}`;
    document.body.append(link);
    link.click();
    link.remove();
    window.setTimeout(() => URL.revokeObjectURL(url), 0);
    setStatus("下载已开始", "success");
  });

  updateInputStats();
</script>

<style>
  .tool-header {
    margin-bottom: 34px;
  }

  .format-toolbar {
    display: grid;
    grid-template-columns: minmax(160px, 1fr) 42px minmax(160px, 1fr) auto;
    align-items: end;
    gap: 10px;
    padding: 18px;
    border-block: 1px solid var(--border);
    background: var(--surface);
  }

  .swap-button {
    width: 42px;
    padding: 0;
  }

  .convert-button {
    height: 42px;
  }

  .converter-status {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .converter-status span {
    color: var(--faint);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.7rem;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .editor-panel {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
  }

  .panel-header,
  .editor-footer {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-inline: 13px;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .panel-header {
    border-bottom: 1px solid var(--border);
    font-weight: 650;
  }

  .editor-footer {
    min-height: 38px;
    border-top: 1px solid var(--border);
    color: var(--faint);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.68rem;
  }

  .panel-actions,
  .view-tabs,
  .panel-action,
  .panel-header button,
  .editor-footer button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .panel-actions {
    gap: 4px;
  }

  .view-tabs {
    gap: 2px;
  }

  .view-tab.active {
    color: var(--text);
    background: var(--surface-raised);
  }

  .panel-action,
  .panel-header button,
  .editor-footer button {
    padding: 5px 7px;
    border: 0;
    border-radius: 4px;
    color: var(--muted);
    background: transparent;
    cursor: pointer;
    font: inherit;
  }

  .panel-action:hover,
  .panel-header button:hover:not(:disabled),
  .editor-footer button:hover {
    color: var(--text);
    background: var(--surface-raised);
  }

  .panel-header button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .panel-action input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .document-editor {
    display: block;
    min-height: 520px;
    border: 0;
    border-radius: 0;
    background: #0e110f;
    resize: vertical;
  }

  .document-editor[hidden] {
    display: none;
  }

  .document-editor:focus {
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  #document-output {
    color: #d8dcd9;
  }

  .document-preview {
    display: block;
    width: 100%;
    min-height: 520px;
    border: 0;
    background: #0e110f;
  }

  .document-preview[hidden] {
    display: none;
  }

  @media (max-width: 760px) {
    .format-toolbar {
      grid-template-columns: minmax(0, 1fr) 42px minmax(0, 1fr);
      padding: 14px;
    }

    .convert-button {
      grid-column: 1 / -1;
    }

    .editor-grid {
      grid-template-columns: 1fr;
    }

    .document-editor {
      min-height: 340px;
    }

    .document-preview {
      min-height: 340px;
    }
  }

  @media (max-width: 440px) {
    .format-toolbar {
      grid-template-columns: minmax(0, 1fr) 38px minmax(0, 1fr);
      gap: 7px;
      padding-inline: 10px;
    }

    .swap-button {
      width: 38px;
    }

    .converter-status {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 0;
    }
  }
</style>
