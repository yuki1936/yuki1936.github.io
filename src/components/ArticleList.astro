---
import type { Article } from "../lib/articles";
import {
  categoryMeta,
  formatDate,
  getArticleCategory,
  getArticleSlug,
} from "../lib/articles";

interface Props {
  articles: Article[];
  emptyText?: string;
}

const { articles, emptyText = "这里还没有文章。" } = Astro.props;
---

{
  articles.length > 0 ? (
    <ol class="article-list">
      {articles.map((article) => {
        const category = getArticleCategory(article);
        return (
          <li>
            <a href={`/articles/${getArticleSlug(article)}/`}>
              <div>
                <h3>{article.data.title}</h3>
                {article.data.description && <p>{article.data.description}</p>}
              </div>
              <div class="article-meta">
                <span>{categoryMeta[category].label}</span>
                <time datetime={article.data.published.toISOString()}>
                  {formatDate(article.data.published)}
                </time>
              </div>
            </a>
          </li>
        );
      })}
    </ol>
  ) : (
    <p class="empty-state">{emptyText}</p>
  )
}

<style>
  .article-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-list li {
    border-bottom: 1px solid var(--border);
  }

  .article-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    padding-block: 18px;
    text-decoration: none;
  }

  .article-list h3 {
    color: var(--text);
    font-size: 1rem;
    font-weight: 650;
  }

  .article-list p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .article-meta {
    display: grid;
    min-width: 92px;
    align-content: center;
    justify-items: end;
    color: var(--faint);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.73rem;
  }

  .article-meta span {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .article-list a {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .article-meta {
      display: flex;
      justify-items: initial;
      gap: 12px;
    }
  }
</style>
